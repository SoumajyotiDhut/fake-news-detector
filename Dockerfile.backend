FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN python -c "import nltk; nltk.download('stopwords'); nltk.download('punkt'); nltk.download('wordnet')"

COPY api/              ./api/
COPY download_model.py ./download_model.py

ENV MODEL_DIR=/app/models
ENV DB_PATH=/app/data/predictions.db
ENV PYTHONPATH=/app/api:/app/models

RUN mkdir -p /app/models /app/data

WORKDIR /app/api

EXPOSE 8000

CMD ["sh", "-c", "python /app/download_model.py && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]