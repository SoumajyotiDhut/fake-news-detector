{
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile.backend"
    },
    "deploy": {
        "startCommand": "sh -c 'python /app/download_model.py && uvicorn main:app --host 0.0.0.0 --port $PORT'",
        "healthcheckPath": "/health",
        "restartPolicyType": "ON_FAILURE"
    }
}